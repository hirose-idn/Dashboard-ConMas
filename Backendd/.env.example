# ── DB instance ini — WAJIB ──
# Tiap subcont (Internal/SGP/Systech) punya instance Dashboard ConMas
# SENDIRI, connect ke DB ConMas mereka masing-masing. Ga ada lagi
# DB_SGP_*/DB_SYSTECH_* di sini — itu eksperimen lama yang ditinggalkan.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

PORT=5000

# ── Identitas instance ini, dikirim balik ke Master lewat field "source"
# di response /api/external/* — biar Master tau ini data dari mana.
# Isi salah satu: internal | sgp | systech
SOURCE_NAME=internal

# ── API key buat endpoint /api/external/* ──
# Wajib diisi, string random panjang (bukan kata yang gampang ditebak).
# Ini SATU-SATUNYA gerbang otentikasi buat Master narik data dari instance
# ini — kalau kosong, endpoint /api/external/* otomatis nolak semua request
# (lihat requireApiKey di routes/api-external.js).
# Generate contoh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXTERNAL_API_KEY=

# ── Master Dashboard — narik data SGP/Systech ──
# Kosongkan kalau instance ini BUKAN Hirose (server SGP/Systech gak perlu
# isi ini). Isi begitu Caddy + domain subcont udah siap — sebelum itu,
# source-nya otomatis ke-stub (lihat config/sources.js).
SGP_API_URL=
SGP_API_KEY=
SYSTECH_API_URL=
SYSTECH_API_KEY=

# ── Jam shift buat line dengan scheme "2 Shift" ──
# Line 3-shift TIDAK kepengaruh (jamnya fix 06/14/22, lihat utils/shiftResolver.js).
# KOSONGKAN di instance Internal (defaultnya sudah pas: Shift 1 07:00–16:00,
# Jumat s.d. 17:00; Shift 2 22:00–07:00).
# Di instance SGP & Systech, ISI seperti ini (Shift 1 08:00–20:00, Shift 2 20:00–08:00):
#   SHIFT2_START_HOUR=8
#   SHIFT2_END_HOUR_WEEKDAY=20
#   SHIFT2_END_HOUR_FRIDAY=20
#   SHIFT2_NIGHT_START_HOUR=20
SHIFT2_START_HOUR=
SHIFT2_END_HOUR_WEEKDAY=
SHIFT2_END_HOUR_FRIDAY=
SHIFT2_NIGHT_START_HOUR=

# ── 3-shift (BARU bisa dikonfig — sebelumnya hardcode 06:00/14:00/22:00
# buat SEMUA lokasi tanpa cara ubah tanpa edit kode). Default kalau
# dikosongkan: 6 / 14 / 22 (persis behavior lama).
SHIFT3_START_HOUR=
SHIFT3_SECOND_START_HOUR=
SHIFT3_THIRD_START_HOUR=

# ── Threshold "line dianggap TIDAK RUNNING" dalam menit, dihitung sejak
# jam mulai shift KALAU belum ada data produksi sama sekali. Default 120
# kalau dikosongkan.
LINE_NOT_RUNNING_THRESHOLD_MIN=

# ══════════════════════════════════════════════════════════════
# PUSH-SYNC — fallback kalau pull Tailscale/tunnel putus (lihat
# PUSH_SYNC_NOTES.md). Data disimpan di DB TERPISAH dari ConMas,
# bukan nambah tabel di skema vendor.
# ══════════════════════════════════════════════════════════════

# ── DB terpisah buat nyimpen data push (ISI CUMA DI MASTER/INTERNAL) ──
# Bikin database baru dulu (CREATE DATABASE subcont_sync_db), lalu jalanin
# `node scripts/initSyncDb.js` sekali buat bikin skemanya.
# Kosongkan semua di instance SGP/Systech — mereka gak perlu DB ini.
SYNC_DB_HOST=
SYNC_DB_PORT=5432
SYNC_DB_NAME=
SYNC_DB_USER=
SYNC_DB_PASSWORD=

# ── Auth buat nerima push masuk (ISI CUMA DI MASTER/INTERNAL) ──
# 1 key beda per source — beda dari EXTERNAL_API_KEY (arah pull), biar
# kalau satu bocor yang lain gak ikut kebobol. Generate kayak biasa:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_KEY_SGP=
SYNC_KEY_SYSTECH=

# Umur maksimum (ms) data push yang masih dianggap valid buat fallback.
# Default 300000 (5 menit) kalau dikosongkan.
PUSH_FALLBACK_MAX_AGE_MS=300000

# ── Pengirim push (ISI CUMA DI INSTANCE SGP & SYSTECH, KOSONGKAN DI INTERNAL) ──
# URL endpoint /api/sync di Master. Kalau Master diakses lewat Cloudflare
# Tunnel: https://<subdomain-atau-quick-tunnel>.trycloudflare.com/api/sync
# (atau domain tetap kalau sudah pakai Named Tunnel).
PUSH_MASTER_URL=
# Sama nilainya dengan SYNC_KEY_SGP atau SYNC_KEY_SYSTECH di atas
# (isi yang sesuai identitas instance ini, dari .env Master).
PUSH_SYNC_KEY=
# Interval kirim, ms. Default 60000 (1 menit) kalau dikosongkan.
PUSH_INTERVAL_MS=60000
